# ============================================================
# באר המשאלות — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase — get these from your project dashboard
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI API — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Environment — dev | prod
NEXT_PUBLIC_ENV=dev

# Site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook secret — protects /api/getUserMatches
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-secret-here

# Resend — transactional email (connection notifications)
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be from a Resend-verified domain. For dev: onboarding@resend.dev
RESEND_FROM_EMAIL=mishaalot@yourdomain.com

# Supabase service-role key — server-side only, never expose to the client
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public-facing app URL — used for auth redirect URLs and community link_url generation
# No trailing slash. Example: https://dev.wellofwishes.org
APP_URL=http://localhost:3000

# Community account-linking (server-to-server HMAC)
# Coordinate these values with each community system that integrates with WoW.
# Generate secrets with: openssl rand -hex 32
COMMUNITY_LINK_CLIENT_KEY=your-client-key
COMMUNITY_LINK_SHARED_SECRET=your-shared-secret
